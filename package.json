{
  "name": "hyperdht-explorer",
  "version": "1.0.0",
  "description": "Pear-runtime standalone CLI that explores and monitors the hyperdht network",
  "author": "Mokhtar Naamani",
  "license": "Apache-2.0",
  "private": true,
  "main": "bin.mjs",
  "bin": "bin.mjs",
  "upgrade": "pear://zn3orhc8fe1qoo48edpu1x8e6of9ufbxg7ixjinigcbfgurgnnny",
  "scripts": {
    "format": "prettier . --write && lunte --fix",
    "lint": "prettier . --check && lunte && eslint .",
    "make": "node scripts/make.js",
    "vendor:sync": "node scripts/vendor-sync.js",
    "licenses": "node scripts/licenses.js",
    "make:darwin-arm64": "bare-build --name hyperdht-explorer --standalone --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --name hyperdht-explorer --standalone --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --name hyperdht-explorer --standalone --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --name hyperdht-explorer --standalone --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --name hyperdht-explorer --standalone --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --name hyperdht-explorer --standalone --host win32-x64 --out ./out/win32-x64 bin.mjs",
    "test": "brittle-bare test/index.mjs"
  },
  "keywords": [],
  "dependencies": {
    "b4a": "^1.8.1",
    "bare-fetch": "^3.0.1",
    "bare-fs": "^4.7.2",
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
    "bare-process": "^4.5.0",
    "bare-sqlite": "^0.1.4",
    "bare-storage": "^1.1.0",
    "corestore": "^7.9.2",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperdht": "^6.32.0",
    "hyperdrive": "^13.3.2",
    "hyperswarm": "^4.17.0",
    "pear-runtime": "^1.2.0",
    "ready-resource": "^1.2.0",
    "sodium-universal": "^5.0.1"
  },
  "devDependencies": {
    "bare-build": "^1.0.1",
    "brittle": "^4.0.2",
    "chart.js": "^4.4.1",
    "d3": "^7.9.0",
    "eslint": "^10.6.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lunte": "^1.8.2",
    "prettier": "^3.8.5",
    "prettier-config-holepunch": "^2.0.0"
  }
}
